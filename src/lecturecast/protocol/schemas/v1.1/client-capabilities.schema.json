{
  "$defs": {
    "AdapterIdentity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "codex",
            "claude-code",
            "openclaw",
            "text"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "version"
      ],
      "title": "AdapterIdentity",
      "type": "object"
    },
    "ArtifactVersionSupport": {
      "additionalProperties": false,
      "description": "Per-artifact schema-version negotiation. Optional on ClientCapabilities:\nold clients omit it and fall back to `supported_manifest_versions` (v1.0\npath); v1.1 clients populate it to negotiate presenter/orchestration plans.",
      "properties": {
        "creative_brief": {
          "items": {
            "enum": [
              "1.0",
              "1.1"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Creative Brief",
          "type": "array"
        },
        "orchestration_plan": {
          "items": {
            "const": "1.1",
            "type": "string"
          },
          "maxItems": 4,
          "title": "Orchestration Plan",
          "type": "array"
        },
        "presenter_plan": {
          "items": {
            "const": "1.1",
            "type": "string"
          },
          "maxItems": 4,
          "title": "Presenter Plan",
          "type": "array"
        },
        "production_manifest": {
          "items": {
            "const": "1.0",
            "type": "string"
          },
          "maxItems": 4,
          "title": "Production Manifest",
          "type": "array"
        }
      },
      "title": "ArtifactVersionSupport",
      "type": "object"
    },
    "ClientIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "agentmesh-lecturecast",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ClientIdentity",
      "type": "object"
    },
    "RuntimeCapabilities": {
      "additionalProperties": false,
      "properties": {
        "can_render_locally": {
          "title": "Can Render Locally",
          "type": "boolean"
        },
        "ffmpeg_version": {
          "anyOf": [
            {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ffmpeg Version"
        },
        "has_libass": {
          "title": "Has Libass",
          "type": "boolean"
        },
        "node_version": {
          "anyOf": [
            {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Node Version"
        },
        "python_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
          "title": "Python Version",
          "type": "string"
        },
        "remotion_version": {
          "anyOf": [
            {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Remotion Version"
        }
      },
      "required": [
        "python_version",
        "node_version",
        "remotion_version",
        "ffmpeg_version",
        "has_libass",
        "can_render_locally"
      ],
      "title": "RuntimeCapabilities",
      "type": "object"
    },
    "ThirdPartyProcessorCapability": {
      "additionalProperties": false,
      "description": "BYO third-party processor (e.g. HeyGen). `configured` = the client found\na key + adapter locally (capability presence; a valid M2 compatibility gate).\nThere is deliberately NO `verified` field: preflight results are local\nadvisory and are never uploaded — the server cannot independently verify\nthem without violating the media boundary.",
      "properties": {
        "api_version": {
          "const": "v3",
          "title": "Api Version",
          "type": "string"
        },
        "configured": {
          "title": "Configured",
          "type": "boolean"
        },
        "credential_mode": {
          "const": "byo_local",
          "title": "Credential Mode",
          "type": "string"
        },
        "features": {
          "items": {
            "enum": [
              "idempotency_24h",
              "title_query",
              "read_only_auth_check"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "title": "Features",
          "type": "array"
        },
        "operations": {
          "items": {
            "enum": [
              "direct_asset_upload",
              "photo_avatar",
              "prerecorded_audio_lipsync",
              "asset_delete",
              "video_delete",
              "avatar_delete"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "provider": {
          "const": "heygen",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "api_version",
        "credential_mode",
        "operations",
        "configured"
      ],
      "title": "ThirdPartyProcessorCapability",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "v1.1 capabilities: adds per-artifact version negotiation, BYO third-party\nprocessor declaration, and the \"f5\" local TTS engine. `configured` is\ncapability presence (a valid M2 compatibility gate); there is deliberately\nno `verified` field — preflight results stay local advisory. v1.0\nClientCapabilities stays frozen (byte/digest stable).",
  "properties": {
    "adapter": {
      "$ref": "#/$defs/AdapterIdentity"
    },
    "aspect_ratios": {
      "items": {
        "enum": [
          "16:9",
          "9:16",
          "3:4"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Aspect Ratios",
      "type": "array"
    },
    "capabilities_id": {
      "maxLength": 96,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Capabilities Id",
      "type": "string"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "client": {
      "$ref": "#/$defs/ClientIdentity"
    },
    "component_catalog_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Component Catalog Digest",
      "type": "string"
    },
    "components": {
      "items": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+\\.v[1-9][0-9]*$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Components",
      "type": "array"
    },
    "output_formats": {
      "items": {
        "enum": [
          "mp4",
          "png"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Output Formats",
      "type": "array"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeCapabilities"
    },
    "schema_version": {
      "const": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "supported_artifact_versions": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactVersionSupport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "supported_manifest_versions": {
      "items": {
        "const": "1.0",
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Supported Manifest Versions",
      "type": "array"
    },
    "third_party_processors": {
      "items": {
        "$ref": "#/$defs/ThirdPartyProcessorCapability"
      },
      "maxItems": 4,
      "title": "Third Party Processors",
      "type": "array"
    },
    "tts_engines": {
      "items": {
        "enum": [
          "edge",
          "minimax",
          "system",
          "f5",
          "none"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Tts Engines",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "capabilities_id",
    "client",
    "adapter",
    "supported_manifest_versions",
    "component_catalog_digest",
    "components",
    "aspect_ratios",
    "output_formats",
    "tts_engines",
    "runtime",
    "captured_at"
  ],
  "title": "ClientCapabilitiesV1_1",
  "type": "object"
}
